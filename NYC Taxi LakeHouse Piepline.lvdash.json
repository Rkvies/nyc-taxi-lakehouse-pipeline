{
  "datasets": [
    {
      "name": "c67ef54c",
      "displayName": "dim_date",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.dim_date",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "7d390157",
      "displayName": "dim_location",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.dim_location",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "a001a4dd",
      "displayName": "dim_vendor",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.dim_vendor",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "afc4aaf7",
      "displayName": "fact_trips",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.fact_trips",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "fare_bucket",
            "expr": "CASE WHEN fare_amount < 10 THEN '$0–10' WHEN fare_amount < 20 THEN '$10–20' WHEN fare_amount < 40 THEN '$20–40' WHEN fare_amount < 60 THEN '$40–60' ELSE '$60+' END"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "tip_percentage",
            "expr": "SUM(tip_amount) * 100.0 / NULLIF(SUM(fare_amount), 0)",
            "displayName": "Tip Percentage",
            "comment": "Percentage of tips relative to total fare amount"
          }
        ]
      }
    }
  ],
  "relationshipGraphs": [
    {
      "sources": [
        {
          "name": "dim_date",
          "datasetName": "c67ef54c"
        },
        {
          "name": "dim_location",
          "datasetName": "7d390157"
        },
        {
          "name": "dim_vendor",
          "datasetName": "a001a4dd"
        },
        {
          "name": "fact_trips",
          "datasetName": "afc4aaf7"
        }
      ],
      "relationships": [
        {
          "name": "fact_trips_dim_date",
          "from": "fact_trips",
          "to": "dim_date",
          "on": "`fact_trips`.`pickup_date` = `dim_date`.`date_key`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "fact_trips_dim_location",
          "from": "fact_trips",
          "to": "dim_location",
          "on": "`fact_trips`.`location_sk` = `dim_location`.`location_sk`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "fact_trips_dim_vendor",
          "from": "fact_trips",
          "to": "dim_vendor",
          "on": "`fact_trips`.`vendor_sk` = `dim_vendor`.`vendor_sk`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        }
      ]
    }
  ],
